# Copy to backend/.env and edit. Every value is optional.
HOST=127.0.0.1
PORT=8000

# Run the live pipeline (GFS download + forecasts) in the background every REFRESH_MINUTES
AUTO_PIPELINE=1
REFRESH_MINUTES=60

# Past GFS data downloaded on first start and kept on disk (hours)
GFS_BACKFILL_HOURS=48
GFS_KEEP_HOURS=54

# Monte Carlo tracks for district strike probabilities
N_MC_TRACKS=1000

# Optional custom folders
# CYCLONE_ARTIFACTS=/path/to/artifacts
# CYCLONE_DATA=/path/to/data

# Team password for actions that change data (add/delete storm positions, run a cycle, reload models).
# Set it in Render -> Environment. Leave empty only for local testing.
ADMIN_TOKEN=
